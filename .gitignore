# Environnement virtuel Python
.venv/
venv/
env/
ENV/

# Caches Python et Notebooks
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Fichiers de données volumineux (> 100 Mo rejetés par GitHub)
# Les signaux EEG bruts (.csv) et acquisitions (.mat)
data/*.csv
data/**/*.csv
data/*.mat
data/**/*.mat

# Scripts de test et brouillons temporaires
scratch/

# Fichiers temporaires et sorties
output/*
!output/.gitkeep
*.log

# Fichiers système & IDE
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
